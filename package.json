{
  "name": "system-analysis-learning-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "System design শেখার game: ParcelGo delivery city-তে খেলে শেখা",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:meta": "node scripts/gen-meta.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:e2e": "VITE_E2E=1 vite build --outDir dist-e2e",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.120.0",
    "firebase": "^11.10.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  }
}
